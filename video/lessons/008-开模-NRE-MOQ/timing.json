{
  "total": 91.488,
  "beats": [
    {
      "index": 0,
      "text": "今天讲三个跟钱有关的词：开模、NRE、MOQ。",
      "keywords": [
        "开模",
        "NRE",
        "MOQ"
      ],
      "visual": "teacher",
      "note": "三个花钱的词",
      "start": 0.0,
      "end": 5.328,
      "duration": 5.328
    },
    {
      "index": 1,
      "text": "先说开模。塑料外壳不是打印出来的，是用模具压出来的。",
      "keywords": [
        "模具"
      ],
      "visual": "mold",
      "note": "模具压外壳",
      "start": 5.678,
      "end": 11.822,
      "duration": 6.144
    },
    {
      "index": 2,
      "text": "模具像做月饼的模子：先花大钱做模子，之后每个外壳都用同一个模子做。",
      "keywords": [
        "月饼模子"
      ],
      "visual": "mold",
      "note": "先做模子再生产",
      "start": 12.172,
      "end": 18.796,
      "duration": 6.624
    },
    {
      "index": 3,
      "text": "做一个模具可能要几十万，这是一次性投入。",
      "keywords": [
        "贵"
      ],
      "visual": "mold",
      "note": "几十万一次",
      "start": 19.146,
      "end": 23.682,
      "duration": 4.536
    },
    {
      "index": 4,
      "text": "NRE全称Non-Recurring Engineering，就是只花一次的钱：设计费、开模费、认证费。",
      "keywords": [
        "NRE"
      ],
      "visual": "nre",
      "note": "只花一次的钱",
      "start": 24.032,
      "end": 32.408,
      "duration": 8.376
    },
    {
      "index": 5,
      "text": "不做产品就没有这笔钱，做多少台都要先付这一笔。",
      "keywords": [
        "先付钱"
      ],
      "visual": "nre",
      "note": "开工先花",
      "start": 32.758,
      "end": 37.462,
      "duration": 4.704
    },
    {
      "index": 6,
      "text": "MOQ全称Minimum Order Quantity，就是最小起订量。",
      "keywords": [
        "MOQ"
      ],
      "visual": "moq",
      "note": "最小订单量",
      "start": 37.812,
      "end": 42.828,
      "duration": 5.016
    },
    {
      "index": 7,
      "text": "工厂不愿意只做几台，因为开一次产线很贵，常见要求一次至少一千台、五千台。",
      "keywords": [
        "起订量"
      ],
      "visual": "moq",
      "note": "最少1000台",
      "start": 43.178,
      "end": 50.594,
      "duration": 7.416
    },
    {
      "index": 8,
      "text": "量太小，工厂连成本都收不回来。",
      "keywords": [
        "成本"
      ],
      "visual": "moq",
      "note": "量小亏本",
      "start": 50.944,
      "end": 56.128,
      "duration": 5.184
    },
    {
      "index": 9,
      "text": "为什么PM必须懂？因为总成本等于NRE一次性，加上BOM每台乘数量。",
      "keywords": [
        "总成本"
      ],
      "visual": "money",
      "note": "NRE加BOM乘数量",
      "start": 56.478,
      "end": 63.246,
      "duration": 6.768
    },
    {
      "index": 10,
      "text": "量小的时候，NRE摊到每台特别贵。所以硬件要走量，量越大，每台摊的固定成本越低。",
      "keywords": [
        "走量"
      ],
      "visual": "chart",
      "note": "量越大越便宜",
      "start": 63.596,
      "end": 72.764,
      "duration": 9.168
    },
    {
      "index": 11,
      "text": "记住一句话：开模和NRE是一次性的钱，BOM是每台的钱，MOQ是工厂的最小订单。",
      "keywords": [
        "一句话记住"
      ],
      "visual": "star",
      "note": "三种钱分清",
      "start": 73.114,
      "end": 83.41,
      "duration": 10.296
    },
    {
      "index": 12,
      "text": "课后想一想：为什么工厂要求一次最少做一千台，不能一台一台做？",
      "keywords": [
        "课后想一想"
      ],
      "visual": "q",
      "note": "一句就行",
      "start": 83.76,
      "end": 91.824,
      "duration": 8.064
    }
  ]
}